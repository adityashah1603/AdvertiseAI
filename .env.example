# Copy this file to .env and fill in real values. Never commit .env itself.
#
# The "Used by" line on each var is a hard boundary, not a suggestion — see
# docs/DECISIONS.md §3.4 (blast radius of agent credentials). The generation
# sandbox and the deployment sandbox each get only their own subset of these
# when the orchestrator hydrates them; this root .env is where the
# orchestrator (running on your infra, never inside a sandbox) reads from.

# ---- Anthropic (Claude) ----
# Used by: the generation agent AND the deployment agent, both running inside
# their respective sandboxes via the Claude Agent SDK / `claude -p`.
ANTHROPIC_API_KEY=

# ---- OpenAI ----
# Used by: the GENERATION sandbox only (gpt-image-2 plate calls).
# The deployment sandbox must never receive this key.
OPENAI_API_KEY=

# ---- E2B (sandbox provider) ----
# Used by: the orchestrator, to create/destroy sandboxes. Never given to a
# sandbox itself — a box has no business creating other boxes.
E2B_API_KEY=

# ---- Kernel (managed browser + session recording) ----
# Used by: the DEPLOYMENT sandbox only.
KERNEL_API_KEY=

# ---- Supabase (Postgres + Storage) ----
SUPABASE_URL=
# Full access — orchestrator/backend only. Never sent to the frontend, never
# handed wholesale into a sandbox (sandboxes get short-lived scoped tokens
# minted per run instead — see docs/ROADMAP.md §4 and docs/DECISIONS.md §3.4).
SUPABASE_SERVICE_ROLE_KEY=
# Safe for the frontend. Read access only, enforced by RLS policies set up
# when the schema is created (Step 2).
SUPABASE_ANON_KEY=

# ---- Adstream (stand-in ads manager) ----
# Used by: the DEPLOYMENT sandbox only. Never given to the generation sandbox.
ADSTREAM_LOGIN_URL=
ADSTREAM_EMAIL=
ADSTREAM_PASSWORD=

# ---- Concurrency caps (docs/ROADMAP.md §5 / docs/DECISIONS.md §3.3) ----
# Two independent caps because generation and deployment sandboxes compete
# for different resources (image-model + render CPU vs. browser sessions).
# Runtime config, not a literal in code — tune against real provider limits.
GENERATION_CONCURRENCY_CAP=3
DEPLOYMENT_CONCURRENCY_CAP=3
